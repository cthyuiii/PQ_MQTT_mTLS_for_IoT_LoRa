{
    "_comment": "Per-algorithm config for the reference benchmark runner. Each entry describes where the algorithm's source lives after `./clone_algos.sh`, how it builds, and which variants to measure. build_strategy values: 'generic-bench' = compile bench_template.c against the variant's .c files (works for standard NIST submission layouts); 'native-bench' = the algo ships its own benchmark binary, see notes in README.md; 'manual' = no automation, follow README.md by hand.",
    "HAWK": {
        "github": "https://github.com/hawk-sign/dev",
        "root_dir": "HAWK",
        "build_strategy": "native-bench",
        "build_notes": "Generator repo. After `cd HAWK && make`, you'll get Reference_Implementation/hawk_{256,512,1024}/ each containing tests/speed.c. Build that and parse its output - it prints sign/verify cycles to stdout. README.md has the manual recipe.",
        "variants": [
            {
                "name": "HAWK-256",
                "dir": "Reference_Implementation/hawk_256",
                "native_bench": "tests/speed"
            },
            {
                "name": "HAWK-512",
                "dir": "Reference_Implementation/hawk_512",
                "native_bench": "tests/speed"
            },
            {
                "name": "HAWK-1024",
                "dir": "Reference_Implementation/hawk_1024",
                "native_bench": "tests/speed"
            }
        ]
    },
    "SDitH": {
        "github": "https://github.com/sdith/sdith",
        "root_dir": "SDitH",
        "build_strategy": "generic-bench",
        "build_notes": "Standard NIST submission layout BUT the hypercube variant's sdith.c #includes x86 immintrin.h / x86intrin.h unconditionally - won't build on arm64 (Apple Silicon). Only the 6 threshold variants are listed below. If you're on x86 you can add the hypercube ones back. opt64/ Keccak subdir is portable C and works on both.",
        "variants": [
            {
                "name": "SDitH-threshold-cat1-gf256",
                "dir": "Reference_Implementation/Threshold_Variant/sdith_threshold_cat1_gf256",
                "include_subdirs": [
                    "sha3",
                    "sha3/opt64"
                ],
                "extra_cflags": [
                    "-Wno-error"
                ],
                "extra_ldflags": [
                    "-lm"
                ]
            },
            {
