    "SQIsign": {
        "github": "https://github.com/SQISign/the-sqisign",
        "root_dir": "SQIsign",
        "build_strategy": "native-bench",
        "build_notes": "CMake-based. Build with: `cd SQIsign && mkdir build && cd build && cmake -DSQISIGN_BUILD_TYPE=ref .. && make`. Then `./test/SQIsign_test_bench lvl1` (or lvl3/lvl5). Parse the printed cycle counts.",
        "variants": [
            {
                "name": "SQIsign-NIST-I",
                "level": "lvl1"
            },
            {
                "name": "SQIsign-NIST-III",
                "level": "lvl3"
            },
            {
                "name": "SQIsign-NIST-V",
                "level": "lvl5"
            }
        ]
    },
    "QR-UOV": {
        "github": "(no canonical repo; NIST CSRC hosts the round-2 submission package)",
        "download": "https://csrc.nist.gov/csrc/media/Projects/pqc-dig-sig/documents/round-2/submission-pkg/qr-uov-submission-round2.zip",
        "root_dir": "QR-UOV",
        "build_strategy": "generic-bench",
        "build_notes": "Run ./setup_qruov.sh - it downloads the 109MB NIST round-2 package, extracts it, discovers every Reference_Implementation variant dir containing api.h, and rewrites this entry to generic-bench with the discovered variants. Then: python3 run_reference_benchmarks.py --algos QR-UOV --probe-only.",
        "variants": [
            {
                "name": "QR-UOV-I-q127L3",
                "dir": "variants/qruov1q127L3v156m54",
                "exclude_files": [
                    "PQCgenKAT_sign.c",
                    "api_h_gen.c",
                    "qruov_config_h_gen.c",
                    "rng.c"
                ],
                "extra_cflags": [
                    "-O3",
                    "-fwrapv",
                    "-DQRUOV_PLATFORM=ref",
                    "-Wno-deprecated-declarations",
                    "-Wno-unused-result",
                    "-Wno-error",
                    "-fopenmp"
                ],
                "extra_ldflags": [
                    "-lcrypto",
                    "-lm"
                ]
