// ---- big painted stack + stack-pointer switch, as liboqs_bench (validated on both boards) ----
#ifndef MT_STACK_KB  // -DMT_STACK_KB: SNOVA's signing needs 26-92 KB (run_benchmarks.py)
#ifdef MT_KEX_ONLY
