# ============================================================
# IoT-PQC — .gitignore
# ============================================================
# Goal: keep the repo small and not leak secrets / test artifacts.
# Tracked: source code, docs (docs/), requirements.txt, scripts/.
# Everything else is regenerable.

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
desktop.ini

# ----- Editors / IDEs -----
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
*.sublime-workspace
*.sublime-project

# ----- Python source artifacts -----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.hypothesis/
.tox/
.nox/

# ----- Virtual environments (NEVER commit) -----
.venv
.venv/
.venv.nosync/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
pyvenv.cfg

# ----- Jupyter -----
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/

# ----- C / C++ / native build artifacts -----
build/
dist/
out/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.exe
*.dll
*.class

# ----- Cython generated files -----
# pqc_cython_sig.c is regenerated by `setup.py build_ext`; the .so is
# platform-specific and shouldn't be committed.

# ----- NIST reference-impl downloads + builds -----
# Each algorithm's submission package is large (~10-100 MB) and is fetched
# on demand by signatures/reference/clone_algos.sh.  Don't
# commit the unpacked sources or the per-variant `bench` binaries.
signatures/reference/HAWK/
signatures/reference/MQOM/
signatures/reference/SDitH/
signatures/reference/QR-UOV/
signatures/reference/FAEST/
signatures/reference/SQIsign/
signatures/reference/**/bench

# ----- Run-all script artifacts (run_all.sh) -----
# FAEST_flat/ is ~500 generated files, recreated by prepare_faest_flat.sh.
# build_pi/ and build_mac/ are SQIsign cmake trees (already inside the
# ignored SQIsign/ dir; kept explicit in case source dirs are un-ignored).
signatures/reference/FAEST_flat/
signatures/reference/**/build_pi/
signatures/reference/**/build_mac/
signatures/reference/**/build_release/
# Captured native benchmark outputs (parsed into results/, then disposable)
signatures/reference/hawk_results.txt
signatures/reference/mqom_results.txt
signatures/reference/faest_results.txt
signatures/reference/sqisign_lvl*.txt
# Compiled benchmark binaries (no extension, so *.o/*.so rules miss them)
signatures/openssl_sig_speed
signatures/liboqs_sig_speed
signatures/wolfssl_sig_speed
# fetched/built by network/build_ascon.sh + build_wolfssl.sh
network/ascon-c/
network/aead_speed
network/mqtt_tls_timer
network/mqtt_tls_timer_wolfssl
network/mqtt_kem_timer
network/tls_handshake_timer

# ----- CMake leftovers -----
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# ----- Archive blobs -----
*.7z
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.gz
*.bz2
*.xz

# ----- Logs / temp / backups -----
*.log
*.tmp
*.temp
*.bak

# ----- Environment / secrets -----
.env
.env.local
.env.*.local
.envrc
.direnv/

# ----- TLS certificates and private keys -----
# All test certs are regeneratable via gen_certs.sh — and the .key files
# contain private keys you should never commit.
certs/
certs_single_ca/
*.pem
*.key
*.crt
*.cert
*.csr
*.der
*.p12
*.pfx
server_identity.pub
server_identity.sk

# ----- External source trees (cloned for builds, not part of this repo) -----
wolfssl/
wolfssl-*/
wolfssl-src/
liboqs/
liboqs-*/
liboqs-src/
oqs-provider/
oqs-provider-*/
openssl-*/

# ----- Measurement output -----
# Result CSVs are regenerable via the benchmark scripts.  Comment these
# four lines out if you want to commit a particular snapshot for the slide
# deck / literature report.
results/
network/results/
experiments/results/

# ----- Generated deliverables (not committed; produced by build scripts) -----
IoT-PQC_Progress.pptx
PQC Performance Sheets.xlsx
# Literature_Comparison_Report.docx
*.pdf

# ----- Local build scripts for the deck / workbook (regenerated, not tracked) -----
build_progress_deck.py
build_perf_sheet.py

# ----- Dependency manager directories -----
node_modules/
.pnpm-store/
.yarn/

# ----- Misc tooling caches -----
.cache/
.parcel-cache/
.next/
.nuxt/

# ----- iCloud Drive sync duplicates -----
# The repo lives in iCloud Drive, which writes "name 2.ext" / "dir 2/" on every sync
# collision; the copies are byte-identical to their originals or older drafts.
* [2-9]
* [2-9].*
*.RESTORED.bak

# ----- Local-only trees -----
# pico/PQClean: local PQClean clone the sketches were vendored from
pico/PQClean/
# _refsrc/: ~160 MB of upstream reference sources used to prepare the pico/ sketches
_refsrc/
# hawk-tls13/: a local HAWK-in-TLS experiment
/hawk-tls13/

# ----- Sessions / scratch left by editors or by you -----
*.session
*.scratch
s2.pptx
PQC_Experiment.xlsx
